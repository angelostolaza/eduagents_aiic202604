# ─── App ──────────────────────────────────────────────────────────────────────
APP_ENV=development
APP_SECRET_KEY=change-this-to-a-random-64-char-hex-string-never-commit
APP_CORS_ORIGINS=http://localhost:3000,http://localhost:5500

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://historylive:historylive@localhost:5432/historylive

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Object Storage (MinIO locally; swap to R2/S3 in prod) ───────────────────
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=historylive
STORAGE_REGION=us-east-1
STORAGE_URL_EXPIRY_SECONDS=900

# ─── AI Provider Keys ─────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GOOGLE_API_KEY=AIza...
ELEVENLABS_API_KEY=...
HIGGSFIELD_API_KEY=...

# ─── Default Models ───────────────────────────────────────────────────────────
DEFAULT_RESEARCH_MODEL=claude-opus-4-7
DEFAULT_SCRIPTING_MODEL=claude-opus-4-7
DEFAULT_SEED_IMAGE_MODEL=gemini-3.0-flash-preview-image-generation
DEFAULT_VIDEO_MODEL=veo-3.1-standard
DEFAULT_VOICE_MODEL=eleven_v3

# ─── Rate Limits ──────────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=30
RATE_LIMIT_PER_HOUR=200

# ─── Cost Caps (cents) ────────────────────────────────────────────────────────
MAX_COST_CENTS_PER_REQUEST=2000
MAX_COST_CENTS_PER_USER_DAY=5000
MAX_COST_CENTS_GLOBAL_DAY=50000

# ─── Access Tiers ─────────────────────────────────────────────────────────────
PUBLIC_TIER_ENABLED=true
WHITELISTED_AUTO_GENERATE=true
WHITELISTED_DAILY_CAP=2
WHITELISTED_WEEKLY_CAP=10

# ─── Feature Flags ────────────────────────────────────────────────────────────
SCRIPTING_REVIEW_GATE_ENABLED=true

# ─── Observability ────────────────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=https://api.honeycomb.io
OTEL_SERVICE_NAME=historylive-backend
